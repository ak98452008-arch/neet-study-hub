# Reference only. Pages Git deployments use dashboard bindings.
# Rename/edit only if you know how to use Wrangler.
name = "neet-study-hub"
compatibility_date = "2026-10-01"

[[d1_databases]]
binding = "DB"
database_name = "neet-study-hub-db"
database_id = "REPLACE_WITH_YOUR_DATABASE_ID"

[[r2_buckets]]
binding = "FILES"
bucket_name = "neet-study-hub-files"
